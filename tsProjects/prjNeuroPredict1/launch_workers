import subprocess
import sys
import os
import time
import socket


# === CONFIGURATION ===
num_workers = 1  # Number of worker tuners to launch
base_port = 8002  # Starting port number for workers (chief uses 8001)
script_to_run = os.path.join('tsProjects','prjNeuroPredict1', 'tsNeuroPredictWinMql_chief.py') # Your main tuning script
print(f"Script to run: {script_to_run}")
# Ensure the script exists  

oracle_ip = "WINSVRXERCES01"
oracle_port = "8000"  # Chief listens on this

# Chief first
print("🟢 Launching Chief...")
chief_env = os.environ.copy()
chief_env["TUNER_ID"] = "chief"
chief_proc = subprocess.Popen(
    [sys.executable, "tsProjects\\prjNeuroPredict1\\tsNeuroPredictWinMql_chief.py"],
    env=chief_env,
    stdout=subprocess.PIPE,
    stderr=subprocess.PIPE
)

# Wait for the Oracle server to come online
print("⏳ Waiting for chief (Oracle) to initialize...")
time.sleep(10)


# === Launch Workers ===
processes = []

for i in range(num_workers):
    tuner_id = f"tuner{i+1}"  # e.g., tuner1, tuner2, ...
    worker_port = str(base_port + i)

    env = {
        "TUNER_ID": tuner_id,
        "KERASTUNER_ORACLE_IP": oracle_ip,
        "KERASTUNER_ORACLE_PORT": oracle_port,
        "KERASTUNER_ORACLE_WORKER": "True",
        "KERASTUNER_ORACLE_WORKER_ID": tuner_id,
        "KERASTUNER_ORACLE_WORKER_PORT": worker_port,
    }

    # Merge with current environment variables
    full_env = {**env, **dict(**os.environ)}

    print(f"Launching {tuner_id} on port {worker_port}...")

    proc = subprocess.Popen(
        [sys.executable, script_to_run],
        env=full_env,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE
    )
    processes.append((tuner_id, proc))

# Optional: Wait and capture logs
for tuner_id, proc in processes:
    out, err = proc.communicate()
    print(f"\n[{tuner_id} stdout]\n", out.decode())
    print(f"\n[{tuner_id} stderr]\n", err.decode())
